+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import { compileRenderVariant } from '../src/render-prewarm.js';
+
+const scene=new THREE.Scene(),source=new THREE.Group(),camera=new THREE.PerspectiveCamera();
+const geometry=new THREE.BoxGeometry(),material=new THREE.MeshStandardMaterial();
+const exterior=new THREE.InstancedMesh(geometry,material,1),interior=new THREE.Mesh(geometry,material);
+exterior.layers.set(3);exterior.visible=false;interior.layers.set(5);
+const light=new THREE.PointLight();light.layers.set(3);light.castShadow=true;
+source.add(exterior,interior,light);scene.add(source);
+let sharedDisposals=0;material.addEventListener('dispose',()=>sharedDisposals++);geometry.addEventListener('dispose',()=>sharedDisposals++);
+let target='player',face=2,mip=1,reject,privateDisposals=0,observed;
+const renderer={getRenderTarget:()=>target,getActiveCubeFace:()=>face,getActiveMipmapLevel:()=>mip,
+  setRenderTarget(value,f=0,m=0){target=value;face=f;mip=m;},
+  compileAsync(group,compileCamera,compileScene) {
+    const lights=[],renderables=[];compileScene.traverse(o=>{if(o.isLight)lights.push(o);});
+    group.traverse(o=>{if(o.isMesh)renderables.push(o);assert.equal(Boolean(o.isLight),false);});
+    assert.equal(camera.layers.mask,1);assert.equal(compileCamera.layers.mask,8);
+    assert.equal(lights.length,1,'Compile must not collect ship interior lights twice');
+    assert.equal(renderables.length,1);assert.equal(renderables[0].geometry,geometry);assert.equal(renderables[0].material,material);
+    assert.notEqual(renderables[0],exterior);assert.equal(renderables[0].isInstancedMesh,true);
+    renderables[0].addEventListener('dispose',()=>privateDisposals++);
+    assert.equal(exterior.visible,false);assert.equal(source.parent,scene);assert.equal(target,'hdr');
+    observed={group,compileCamera};return new Promise((_resolve,fail)=>{reject=fail;});
+  }};
+const pending=compileRenderVariant(renderer,source,camera,scene,{layer:3,target:'hdr'});
+assert.equal(target,'player');assert.equal(face,2);assert.equal(mip,1);
+assert.equal(privateDisposals,1);assert.equal(sharedDisposals,0);assert.equal(observed.group.children.length,0);
+// The player is free to change state while KHR readiness remains unresolved.
+camera.layers.set(5);exterior.visible=true;renderer.setRenderTarget('next-player');
+reject(Error('compile failed'));await assert.rejects(pending,/compile failed/);
+assert.equal(camera.layers.mask,32);assert.equal(exterior.visible,true);assert.equal(target,'next-player');
+renderer.compileAsync=()=>{throw Error('synchronous compile failure');};
+assert.throws(()=>compileRenderVariant(renderer,source,camera,scene,{layer:3,target:'hdr'}),/synchronous/);
+assert.equal(target,'next-player');assert.equal(camera.layers.mask,32);assert.equal(sharedDisposals,0);
+geometry.dispose();material.dispose();
+console.log('PASS: private render variants, one light traversal, layer/type filtering, synchronous restore, delayed rejection and shared-resource ownership.');
diff --git a/tools/cloudintervaltest.js b/tools/cloudintervaltest.js
new file mode 100644
--- /dev/null
+++ b/tools/cloudintervaltest.js
@@ -0,0 +1,40 @@
+// Independent scan reference for every conservative cell, including shell
+// sentinels. Intervals accelerate traversal; they must not change its support.
+import assert from 'node:assert/strict';
+import { buildCandidateAcceleration, CANDIDATE_WIDTH, CANDIDATE_HEIGHT,
+  CANDIDATE_LAYERS } from '../src/cloud/production-bands.js';
+
+const width=CANDIDATE_WIDTH,height=CANDIDATE_HEIGHT,depth=CANDIDATE_LAYERS;
+const stride=width*height;
+const cases=[new Uint16Array(stride*depth),new Uint16Array(stride*depth).fill(65535),
+  Uint16Array.from({length:stride*depth},(_,i)=>{
+    const z=Math.floor(i/stride),cell=i%stride;
+    return (z===0&&cell%3===0)||(z===depth-1&&cell%5===0)||(z*17+cell*13)%29<4
+      ? 1<<((z+cell)%16):0;
+  })];
+let checked=0;
+for(const masks of cases) {
+  const original=masks.slice(),output=new Uint16Array(masks.length*2);
+  assert.equal(buildCandidateAcceleration(masks,width,height,depth,output),output);
+  assert.deepEqual(masks,original,'Building acceleration changed authored mask bits');
+  for(let z=0;z<depth;z++)for(let cell=0;cell<stride;cell++) {
+    const i=z*stride+cell,packed=output[i*2+1];
+    assert.equal(output[i*2],masks[i]);
+    let below=0,above=depth;
+    for(let k=z-1;k>=0;k--)if(masks[k*stride+cell]){below=k+1;break;}
+    for(let k=z+1;k<depth;k++)if(masks[k*stride+cell]){above=k;break;}
+    assert.equal(packed&127,below);assert.equal(packed>>7,above);
+    assert.ok(packed<=16383,'Packed metadata must be exact in the Float32 surface atlas');
+    checked++;
+  }
+}
+// The OR of endpoints may fill a gap; deriving endpoint indexes then mixing
+// them would miss this support. Rebuild from the exact conservative union.
+const first=new Uint16Array(4*8),second=first.slice();
+first[4]=1;second[20]=32768;
+const union=first.map((v,i)=>v|second[i]),acceleration=buildCandidateAcceleration(union,2,2,8);
+assert.equal(acceleration[(3*4)*2+1]&127,2);
+assert.equal(acceleration[(3*4)*2+1]>>7,5);
+assert.throws(()=>buildCandidateAcceleration(first,2,2,128),RangeError);
+assert.throws(()=>buildCandidateAcceleration(first,2,2,8,new Uint16Array(1)),RangeError);
+console.log(`PASS: ${checked} exact radial interval/mask cells, empty/full/edge/mixed columns, conservative union and surface encoding.`);
