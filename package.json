{
  "name": "deep-space",
  "version": "0.38.0",
  "description": "A fully procedural explorable universe in the browser. Stars, planets with consistent terrain from orbit to on-foot, all generated from a seed.",
  "type": "module",
  "scripts": {
    "dev": "node tools/server.js",
    "test": "node tools/test.js && node tools/graphicssettingstest.js && node tools/renderlooktest.js && node tools/cloudspeciestest.js && node tools/weathersystemtest.js && node tools/cloudsamplingtest.js && node tools/cloudresourcetest.js && node tools/astronomytest.js && node tools/galaxycatalogtest.js && node tools/artificialtest.js && node tools/worldlocktest.js",
    "test:cloud-species": "node tools/cloudspeciestest.js",
    "test:weather-system": "node tools/weathersystemtest.js",
    "test:cloud-sampling": "node tools/cloudsamplingtest.js",
    "test:cloud-resources": "node tools/cloudresourcetest.js",
    "test:galaxy": "node tools/galaxycatalogtest.js",
    "test:starmap": "node tools/starmaptest.js",
    "test:artificial": "node tools/artificialtest.js && node tools/artificialplaytest.js",
    "test:clouds": "node tools/clouddiag.js",
    "test:terrain-startup": "node tools/terrainstartdiag.js",
    "test:igpu": "node tools/igputest.js",
    "test:sysview": "node tools/sysviewtest.js",
    "test:terrain": "node tools/sanity.js",
    "test:stage-a": "node tools/stageatest.js && node tools/terrainnoisediag.js",
    "test:stage-b": "node tools/stagebatmospheretest.js && node tools/weathertest.js",
    "test:gameplay": "node tools/gameplaytest.js",
    "test:performance": "node tools/perftest.js",
    "test:hero-handoff": "node tools/hero-playtest.js",
    "test:cloud-reference": "node tools/cloudvisualdiag.js",
    "test:atmosphere-motion": "node tools/atmospheremotiondiag.js",
    "test:atmosphere-visual": "node tools/atmospherevisualdiag.js",
    "test:atmosphere-traversal": "node tools/atmospheretraversaldiag.js",
    "test:graphics": "node tools/waterinteractiontest.js && node tools/graphicsplaytest.js",
    "test:visual-smoke": "node tools/visualsmoke.js",
    "test:render-look": "node tools/renderlooktest.js && node tools/renderlookplaytest.js && node tools/renderlookworldtest.js",
    "test:render-look:perf": "node tools/renderlookperftest.js",
    "test:vegetation": "node tools/vegetationtest.js",
    "test:rift": "node tools/rifttest.js",
    "test:rift:perf": "node tools/riftperftest.js",
    "test:pointerlock": "node tools/pointerlocktest.js",
    "test:astronomy:browser": "node tools/astroplaytest.js",
    "test:satellite-eclipse": "node tools/satelliteeclipsevisualtest.js",
    "build": "npm test && node tools/build.js",
    "build:pages": "node tools/build.js",
    "shots": "node tools/screenshot.js",
    "world:lock": "node tools/export-galaxy-catalog.js && node tools/export-canonical-world.js",
    "world:curate": "node tools/curate-finite-galaxies.js 256",
    "world:curate:shots": "node tools/capture-finite-candidates.js",
    "explore": "node tools/explore.js",
    "seamtest": "node tools/seamtest.js",
    "touchtest": "node tools/touchtest.js"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "playwright": "1.56.0",
    "pngjs": "^7.0.0",
    "three": "^0.185.1"
  },
  "license": "MIT"
}
