{
  "name": "deep-space",
  "version": "0.36.1",
  "description": "A fully procedural explorable universe in the browser. Stars, planets with consistent terrain from orbit to on-foot, all generated from a seed.",
  "type": "module",
  "scripts": {
    "dev": "node tools/server.js",
    "test": "node tools/test.js && node tools/astronomytest.js && node tools/worldlocktest.js",
    "test:terrain": "node tools/sanity.js",
    "test:gameplay": "node tools/gameplaytest.js",
    "test:performance": "node tools/perftest.js",
    "test:rift": "node tools/rifttest.js",
    "test:pointerlock": "node tools/pointerlocktest.js",
    "test:astronomy:browser": "node tools/astroplaytest.js",
    "build": "npm test && node tools/build.js",
    "shots": "node tools/screenshot.js",
    "world:lock": "node tools/export-canonical-world.js",
    "explore": "node tools/explore.js",
    "seamtest": "node tools/seamtest.js",
    "touchtest": "node tools/touchtest.js"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "pngjs": "^7.0.0",
    "three": "^0.170.0"
  },
  "license": "MIT"
}
