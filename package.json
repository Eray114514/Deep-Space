{
  "name": "no-mans-sky-threejs",
  "version": "0.28.4",
  "description": "A fully procedural explorable universe in the browser, inspired by No Man's Sky. Stars, planets with consistent terrain from orbit to on-foot, all generated from a seed.",
  "type": "module",
  "scripts": {
    "dev": "node tools/server.js",
    "test": "node tools/test.js && node tools/astronomytest.js",
    "test:terrain": "node tools/sanity.js",
    "test:gameplay": "node tools/gameplaytest.js",
    "test:astronomy:browser": "node tools/astroplaytest.js",
    "build": "npm test && node tools/build.js",
    "shots": "node tools/screenshot.js",
    "explore": "node tools/explore.js",
    "seamtest": "node tools/seamtest.js",
    "touchtest": "node tools/touchtest.js"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "pngjs": "^7.0.0",
    "three": "^0.170.0"
  },
  "license": "MIT"
}
